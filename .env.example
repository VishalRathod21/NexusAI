# Copy this file to .env and fill in what you need. Never commit .env.

# ---------------------------------------------------------------- LLM
# offline = no LLM calls: agents return extractive summaries of the evidence
#           they retrieved. Good for wiring checks, tests and demos without a key.
# groq | gemini | openai = real synthesis. Set the matching key below.
LLM_PROVIDER=offline

# Leave empty to use the built-in default for the provider. Model names are
# retired over time, so check your provider's current list if a call fails.
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Price of your model in USD per 1M tokens. Left at 0, cost is reported as
# "not configured" instead of a guessed number.
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0

# ------------------------------------------------------ Orchestration
# a2a   = orchestrator talks to the four agent services over the A2A protocol
# local = agents run in-process (Phase 1 stepping stone; used by tests)
ORCHESTRATION_MODE=a2a

MARKET_AGENT_URL=http://127.0.0.1:9001
COMPETITOR_AGENT_URL=http://127.0.0.1:9002
CUSTOMER_AGENT_URL=http://127.0.0.1:9003
STRATEGY_AGENT_URL=http://127.0.0.1:9004

AGENT_TIMEOUT_SECONDS=180
TOOL_TIMEOUT_SECONDS=25
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5

# ---------------------------------------------------------------- MCP
MCP_WEB_URL=http://127.0.0.1:9101/mcp
MCP_BUSINESS_URL=http://127.0.0.1:9102/mcp
MCP_CALCULATOR_URL=http://127.0.0.1:9103/mcp

# ddgs    = live DuckDuckGo search and real page fetches
# fixture = small synthetic corpus bundled with the repo (offline, deterministic,
#           includes a poisoned page for the prompt-injection demo)
WEB_SEARCH_BACKEND=ddgs

# -------------------------------------------------------- Persistence
# SQLite needs no setup. For PostgreSQL use:
#   postgresql+asyncpg://nexusai:nexusai@localhost:5432/nexusai
DATABASE_URL=sqlite+aiosqlite:///./nexusai.db

# Empty = in-memory cache inside each process. Example: redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------ Observability
# Optional. Leave empty to keep tracing local (spans are stored with each report).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------- Accounts and access
# Anyone can create an account while this is true. The first account created
# becomes the administrator.
ALLOW_SIGNUP=true
SESSION_DAYS=7
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Shared secret between the backend, the agents and the MCP servers. They
# reject calls that do not present it. `scripts/run_all.py` generates one per
# launch if this is empty; Docker requires you to set it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Only needed for Docker: the PostgreSQL password.
POSTGRES_PASSWORD=

# ----------------------------------------------------------- Frontend
# Where the React dev server forwards /api calls, and the port the backend uses.
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LOG_LEVEL=INFO
